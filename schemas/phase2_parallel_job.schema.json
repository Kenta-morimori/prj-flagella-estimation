{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Phase 2 parallel job",
  "type": "object",
  "required": ["schema_version", "job_id", "configs", "execution"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "minLength": 1},
    "configs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^conf/phase2_sweeps/.+\\.ya?ml$"}},
    "execution": {
      "type": "object",
      "required": ["max_workers"],
      "additionalProperties": false,
      "properties": {
        "max_workers": {"oneOf": [{"const": "auto"}, {"type": "integer", "minimum": 1}]},
        "worker_policy": {"enum": ["host_cpu", "cs10_qualified"]}
      }
    }
  }
}
